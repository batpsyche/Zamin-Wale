generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  mobileNo     String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties         Property[]
  websiteEnquiries   WebsiteEnquiry[]
  propertyEnquiries  PropertyEnquiry[]
  propertyVisits     PropertyVisit[]
}

model Property {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingType        String?
  propertyType       String?
  propertyCategories String?
  city               String?
  locality           String?
  plotArea           String?
  plotAreaUnit       String?
  length             String?
  breadth            String?
  allowedFloors      String?
  hasBoundaryWall    Boolean  @default(false)
  openSides         String?
  hasConstruction    Boolean  @default(false)
  possessionBy       String?
  ownership          String?
  priceTotal         Decimal? @db.Decimal(14, 2)
  pricePerSQFT       Decimal? @db.Decimal(14, 2)
  inclusivePrice     Boolean  @default(false)
  isTaxExcluded      Boolean  @default(false)
  isPriceNegotiable  Boolean  @default(false)
  uniqueFeatures     String?  @db.Text
  propertyVideo      String?  @db.Text
  propertyPhotos     Json?    // string[]
  amenities         Json?    // string[]
  overlooking        Json?    // string[]
  otherFeatures      String?  @db.Text
  propertyFacing     String?
  locationAdvantages Json?    // string[]
  title              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  propertyEnquiries PropertyEnquiry[]
  propertyVisits     PropertyVisit[]
}

model WebsiteEnquiry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  mobile    String?
  message   String?  @db.Text
  createdAt DateTime @default(now())
}

model PropertyEnquiry {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  name       String
  email      String
  mobile     String?
  message    String?  @db.Text
  createdAt  DateTime @default(now())
}

model PropertyVisit {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  email         String
  mobile        String?
  preferredDate String?
  message       String?  @db.Text
  createdAt     DateTime @default(now())
}

model HomepageBanner {
  id              String   @id @default(cuid())
  title           String?
  subtitle        String?
  desktopImageUrl String
  mobileImageUrl  String
  ctaLabel        String?
  ctaHref         String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
